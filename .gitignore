# Experiment outputs (keep the folder, ignore heavy artifacts)
results/*
!results/.gitkeep
*.png
!docs/**/*.png
*.pt
*.ckpt

# outputs/ IS committed: it holds the small representative samples reviewers read.
# Only the run log and the binary edit tensors (regenerated by src/train.py) stay out.
!outputs/**/*.png
outputs/run.log
outputs/edits/*.pt

# Report build intermediates (regenerated by docs/report/build_report.py)
docs/report/reference.docx
docs/report/_pandoc_default.docx
